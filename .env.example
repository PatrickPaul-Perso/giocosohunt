# Aucun secret dans ce fichier.
# Pour la gestion D1 distante, charger les variables en mémoire avec :
# source scripts/load-cloudflare-token.sh
# CLOUDFLARE_API_TOKEN et CLOUDFLARE_ACCOUNT_ID sont lus dans le shell,
# puis transmis uniquement au conteneur admin.

# Auth admin : à définir dans les secrets Worker et dans .dev.vars en local.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secret aléatoire d'au moins 32 caractères.
ADMIN_SESSION_SECRET=
# Comptes Gmail ou Google Workspace autorisés, séparés par des virgules.
ADMIN_EMAILS=
ADMIN_ORIGIN=https://giocosohunt.forgenord.ca
