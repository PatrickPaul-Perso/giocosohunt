---
import { env } from 'cloudflare:workers';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCampaigns } from '../../../lib/campaigns';
import SiteLayout from '../../../components/SiteLayout.astro';
import ScanHistory from '../../../components/ScanHistory.astro';
import { pageLanguage } from '../../../lib/page';
import { getSiteSettings } from '../../../lib/settings';
import { getScanHistory } from '../../../lib/scan-history';

Astro.response.headers.set('Cache-Control', 'no-store');
const language = pageLanguage(Astro);
const settings = await getSiteSettings(env.DB);
const slug = Astro.params.slug;
const campaign = (await getCampaigns(env.DB)).find(({ slug }) => slug === Astro.params.campaign);
if (!campaign) return new Response('Not Found', { status: 404 });
if (!slug || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) return new Response('Not Found', { status: 404 });
let item: { id: string; nickname: string; display_name: string; name_fr: string | null; name_en: string | null; image_key: string | null } | null;
try {
  item = await env.DB.prepare(`SELECT i.id, i.nickname, i.display_name, f.name_fr, f.name_en, f.image_key FROM items i
    JOIN campaigns c ON c.id = i.campaign_id LEFT JOIN figurine_classes f ON f.id = i.class_id
    WHERE c.slug = ? AND i.public_slug = ? AND i.nickname IS NOT NULL`)
    .bind(campaign.slug, slug).first<{ id: string; nickname: string; display_name: string; name_fr: string | null; name_en: string | null; image_key: string | null }>();
} catch {
  return new Response(language === 'fr' ? 'Statistiques indisponibles.' : 'Statistics unavailable.', { status: 503 });
}
if (!item) return new Response('Not Found', { status: 404 });
const history = await getScanHistory(env.DB, item.id);
const responseCount = history.filter((entry) => entry.disposition !== null).length;
const name = (language === 'fr' ? item.name_fr : item.name_en) || item.display_name;
const photos = import.meta.glob<{ default: ImageMetadata }>('../../../assets/items/*.{jpg,jpeg,png,webp}', { eager: true });
const image = item.image_key ? photos[`../../../assets/items/${item.image_key}`]?.default : undefined;
---
<SiteLayout language={language} title={`${item.nickname} — ${language === 'fr' ? 'Historique' : 'History'}`} settings={settings}>
  <main>
    <a href={`/${campaign.slug}`}>← {campaign.title}</a>
    <p class="eyebrow">{language === 'fr' ? 'Statistiques de la figurine' : 'Figurine statistics'}</p>
    <h1>{item.nickname}</h1>
    <p>{name} · {language === 'fr'
      ? `${history.length} ouverture${history.length > 1 ? 's' : ''} du tag · ${responseCount} réponse${responseCount > 1 ? 's' : ''} au formulaire`
      : `${history.length} tag opening${history.length === 1 ? '' : 's'} · ${responseCount} form response${responseCount === 1 ? '' : 's'}`}</p>
    {image && (
      <figure><Image src={image} alt={name} width={720} /></figure>
    )}
    <ScanHistory entries={history} photoBasePath={`/${campaign.slug}/figurines/${slug}/photo`} photoId="index" language={language} />
  </main>
</SiteLayout>
<style>
  main { max-width: 72rem; margin: 2rem auto; padding: 0 1rem 4rem; }
  .eyebrow { margin: 2rem 0 .25rem; color: var(--accent); font-size: .8rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2rem, 7vw, 3.25rem); }
  figure { max-width: 36rem; margin: 1.5rem 0; border-radius: .75rem; overflow: hidden; background: #eee8df; text-align: center; }
  figure :global(img) { display: block; max-width: 100%; max-height: 28rem; width: auto; height: auto; margin: auto; }
</style>
