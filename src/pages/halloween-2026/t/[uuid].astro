---
import { env } from 'cloudflare:workers';
import {
  emptyFormValues,
  parseScanResponse,
  saveScanResponse,
  type Candidate,
  type FormValues,
} from '../../../lib/scan-response';

const { uuid } = Astro.params;
const campaignSlug = 'halloween-2026';

if (!uuid || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(uuid)) {
  return new Response('Figurine introuvable', { status: 404 });
}
if (Astro.request.method !== 'GET' && Astro.request.method !== 'POST') {
  return new Response('Méthode non autorisée', { status: 405 });
}

Astro.response.headers.set('Cache-Control', 'no-store');

let displayName: string;
let modelName: string;
let scanCount: number;
let candidates: Candidate[] = [];
let formValues: FormValues = emptyFormValues();
let errors: string[] = [];

try {
  const item = await env.DB.prepare(`SELECT i.display_name, i.campaign_id, m.name AS model_name
    FROM items i JOIN campaigns c ON c.id = i.campaign_id
    JOIN model_candidates m ON m.id = i.model_candidate_id
    WHERE i.id = ? AND c.slug = ?`)
    .bind(uuid, campaignSlug)
    .first<{ display_name: string; campaign_id: string; model_name: string }>();

  if (!item) return new Response('Figurine introuvable', { status: 404 });
  displayName = item.display_name;
  modelName = item.model_name;

  const candidateResult = await env.DB.prepare(`SELECT id, name FROM model_candidates
    WHERE campaign_id = ? ORDER BY name`)
    .bind(item.campaign_id)
    .all<Candidate>();
  candidates = candidateResult.results;

  if (Astro.request.method === 'GET') {
    const scanEventId = crypto.randomUUID();
    await env.DB.prepare('INSERT INTO scan_events (id, item_id) VALUES (?, ?)')
      .bind(scanEventId, uuid)
      .run();
    formValues = emptyFormValues(scanEventId);
  } else {
    const origin = Astro.request.headers.get('origin');
    if (origin && origin !== new URL(Astro.request.url).origin) {
      return new Response('Origine de formulaire non autorisée', { status: 403 });
    }
    const contentType = Astro.request.headers.get('content-type') ?? '';
    if (!contentType.startsWith('multipart/form-data')) {
      return new Response('Type de formulaire non accepté', { status: 415 });
    }
    if (Number(Astro.request.headers.get('content-length') ?? 0) > 400_000) {
      return new Response('Formulaire trop volumineux', { status: 413 });
    }

    const form = await Astro.request.formData();
    const parsed = await parseScanResponse(form, candidates);
    formValues = parsed.values;
    errors = parsed.errors;

    if (parsed.submission) {
      const result = await saveScanResponse(env.DB, item.campaign_id, uuid, parsed.submission);
      if (result === 'saved') return Astro.redirect('/halloween-2026/merci', 303);
      errors.push(result === 'already_submitted'
        ? 'Cette participation a déjà été enregistrée. Ouvrez de nouveau la fiche pour recommencer.'
        : 'Ce scan est introuvable. Ouvrez de nouveau la fiche pour recommencer.');
    }
    Astro.response.status = 400;
  }

  const summary = await env.DB.prepare('SELECT COUNT(*) AS total FROM scan_events WHERE item_id = ?')
    .bind(uuid)
    .first<{ total: number }>();
  scanCount = summary?.total ?? 0;
} catch {
  console.error('Impossible de traiter la participation à un scan');
  return new Response('Base D1 indisponible ou non préparée. Appliquez les migrations et les données de démonstration.', {
    status: 503,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{displayName} — Giocoso Hunt</title>
  </head>
  <body>
    <main>
      <a class="back" href="/halloween-2026">← Retour à la campagne</a>
      <p class="eyebrow">Giocoso Hunt · Halloween 2026</p>
      <h1>{displayName}</h1>
      <p class="model">Modèle de cette figurine : <strong>{modelName}</strong></p>
      <p class="intro">Figurine découverte! Dites-nous ce que vous souhaitez faire, puis choisissez le prochain modèle.</p>
      <p class="count">Scan enregistré · {scanCount} scan{scanCount > 1 ? 's' : ''} au total pour cette figurine</p>

      {errors.length > 0 && (
        <div class="errors" role="alert">
          <strong>Vérifiez votre réponse :</strong>
          <ul>{errors.map((error) => <li>{error}</li>)}</ul>
        </div>
      )}

      <form method="POST" enctype="multipart/form-data" id="participation-form">
        <input type="hidden" name="scan_event_id" value={formValues.scanEventId} />
        <input type="hidden" name="location_source" value="" />

        <fieldset>
          <legend>1. Votre identification <span>facultative</span></legend>
          <p>Vous pouvez participer sans donner de handle ni de courriel.</p>
          <label for="social-platform">Réseau social</label>
          <select id="social-platform" name="social_platform">
            <option value="">Choisir un réseau</option>
            <option value="tiktok" selected={formValues.socialPlatform === 'tiktok'}>TikTok</option>
            <option value="facebook" selected={formValues.socialPlatform === 'facebook'}>Facebook</option>
            <option value="instagram" selected={formValues.socialPlatform === 'instagram'}>Instagram</option>
          </select>
          <label for="social-handle">Votre handle</label>
          <input id="social-handle" name="social_handle" type="text" autocomplete="off" maxlength="51" placeholder="@votre_handle" value={formValues.socialHandle} />
          <label class="check"><input type="checkbox" name="social_consent" checked={formValues.socialConsent} /> J’autorise Giocoso Hunt à conserver ce handle pour un shoutout manuel et à me taguer sur le réseau choisi.</label>
          <label for="email">Courriel <span>facultatif</span></label>
          <input id="email" name="email" type="email" autocomplete="email" maxlength="254" value={formValues.email} />
          <label class="check"><input type="checkbox" name="email_consent" checked={formValues.emailConsent} /> J’autorise Giocoso Hunt à conserver mon courriel pour me contacter au sujet de cette chasse.</label>
        </fieldset>

        <fieldset>
          <legend>2. La figurine</legend>
          <p>Les instructions pour cacher une figurine à nouveau viendront plus tard.</p>
          <label class="choice"><input type="radio" name="disposition" value="keep" checked={formValues.disposition === 'keep'} required /> Je veux conserver la figurine</label>
          <label class="choice"><input type="radio" name="disposition" value="rehide" checked={formValues.disposition === 'rehide'} required /> Je veux la cacher à nouveau</label>
          <label for="clue">Indice général si vous la cachez à nouveau <span>facultatif</span></label>
          <textarea id="clue" name="clue_text" rows="3" maxlength="160" placeholder="Un indice général, sans adresse ni localisation exacte">{formValues.clueText}</textarea>
          <small>Aucun numéro, adresse, coordonnée ou lien dans le texte.</small>
          <label for="clue-photo">Photo d’indice JPEG <span>facultative, si vous cachez la figurine à nouveau</span></label>
          <input id="clue-photo" name="clue_photo" type="file" accept="image/jpeg" />
          <small>La photo est réduite dans votre navigateur avant l’envoi. Sa taille finale doit être de 300 Ko ou moins.</small>
          <label class="check"><input type="checkbox" name="gps_consent" checked={formValues.gpsConsent} /> J’autorise la conservation privée des coordonnées GPS de cette photo, si elle en contient. Elles ne seront pas affichées publiquement.</label>
          <label class="check"><input type="checkbox" name="device_location_consent" checked={formValues.deviceLocationConsent} /> Si aucun GPS de la photo n’est utilisé, j’autorise la collecte de ma position actuelle pour l’ajouter au JPEG. Elle peut différer du lieu de prise de vue; le navigateur demandera aussi ma permission.</label>
          <p id="photo-status" role="status" aria-live="polite"></p>
        </fieldset>

        <fieldset>
          <legend>3. Le prochain modèle</legend>
          <p>Votez pour un modèle existant ou proposez-en un nouveau.</p>
          <ul class="models">
            {candidates.map((candidate) => (
              <li><label><input type="radio" name="model_choice" value={candidate.id} checked={formValues.modelChoice === candidate.id} required /> {candidate.name}</label></li>
            ))}
            <li><label><input type="radio" name="model_choice" value="propose" checked={formValues.modelChoice === 'propose'} required /> Proposer un nouveau modèle</label></li>
          </ul>
          <label for="proposal">Nom du modèle proposé</label>
          <input id="proposal" name="proposal_name" type="text" maxlength="60" value={formValues.proposalName} placeholder="Votre idée de figurine" />
        </fieldset>

        <button type="submit">Enregistrer ma participation</button>
      </form>
    </main>
    <script>
      import piexif from 'piexifjs';

      const form = document.querySelector<HTMLFormElement>('#participation-form');
      const input = document.querySelector<HTMLInputElement>('#clue-photo');
      const status = document.querySelector<HTMLElement>('#photo-status');
      form?.addEventListener('submit', async (event) => {
        const original = input?.files?.[0];
        if (!original || !input || !status) return;
        event.preventDefault();
        status.textContent = 'Préparation de la photo…';
        try {
          if (original.type !== 'image/jpeg' || original.size > 15_000_000) throw new Error('Choisissez un JPEG de 15 Mo ou moins.');
          const gpsConsent = form.querySelector<HTMLInputElement>('[name="gps_consent"]')?.checked ?? false;
          const deviceLocationConsent = form.querySelector<HTMLInputElement>('[name="device_location_consent"]')?.checked ?? false;
          const sourceField = form.querySelector<HTMLInputElement>('[name="location_source"]');
          if (sourceField) sourceField.value = '';
          const originalUrl = await new Promise<string>((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result));
            reader.onerror = () => reject(new Error('Lecture de la photo impossible.'));
            reader.readAsDataURL(original);
          });
          let gps: Record<number, unknown> | null = null;
          let locationSource: 'photo' | 'device' | null = null;
          if (gpsConsent) {
            try {
              const source = piexif.load(originalUrl).GPS;
              const keys = piexif.GPSIFD;
              if (source && source[keys.GPSLatitudeRef] && source[keys.GPSLatitude] && source[keys.GPSLongitudeRef] && source[keys.GPSLongitude]) {
                locationSource = 'photo';
                gps = {
                  [keys.GPSLatitudeRef]: source[keys.GPSLatitudeRef],
                  [keys.GPSLatitude]: source[keys.GPSLatitude],
                  [keys.GPSLongitudeRef]: source[keys.GPSLongitudeRef],
                  [keys.GPSLongitude]: source[keys.GPSLongitude],
                };
              }
            } catch { /* La photo peut ne contenir aucun EXIF. */ }
          }
          if (!gps && deviceLocationConsent) {
            if (!navigator.geolocation) throw new Error('La position du navigateur est indisponible. Décochez les consentements GPS pour continuer sans coordonnées.');
            status.textContent = 'Demande de la position actuelle…';
            const position = await new Promise<GeolocationPosition>((resolve, reject) => {
              navigator.geolocation.getCurrentPosition(resolve, reject, {
                enableHighAccuracy: true,
                maximumAge: 0,
                timeout: 15_000,
              });
            }).catch(() => { throw new Error('Position refusée ou indisponible. Décochez les consentements GPS pour continuer sans coordonnées.'); });
            const latitude = position.coords.latitude;
            const longitude = position.coords.longitude;
            if (!Number.isFinite(latitude) || !Number.isFinite(longitude) || Math.abs(latitude) > 90 || Math.abs(longitude) > 180) {
              throw new Error('Position actuelle invalide.');
            }
            const keys = piexif.GPSIFD;
            gps = {
              [keys.GPSLatitudeRef]: latitude < 0 ? 'S' : 'N',
              [keys.GPSLatitude]: piexif.GPSHelper.degToDmsRational(Math.abs(latitude)),
              [keys.GPSLongitudeRef]: longitude < 0 ? 'W' : 'E',
              [keys.GPSLongitude]: piexif.GPSHelper.degToDmsRational(Math.abs(longitude)),
            };
            locationSource = 'device';
          }
          if (!gps && gpsConsent) {
            throw new Error('La photo fournie ne contient pas de GPS. Autorisez la position actuelle, ou décochez le consentement GPS pour continuer sans coordonnées.');
          }
          const image = new Image();
          image.src = originalUrl;
          await image.decode();
          const scale = Math.min(1, 1200 / Math.max(image.naturalWidth, image.naturalHeight));
          const canvas = document.createElement('canvas');
          canvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
          canvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
          const context = canvas.getContext('2d');
          if (!context) throw new Error('Compression indisponible dans ce navigateur.');
          context.drawImage(image, 0, 0, canvas.width, canvas.height);
          let compressed: Blob | null = null;
          for (let attempt = 0; attempt < 4; attempt++) {
            for (const quality of [0.8, 0.65, 0.5, 0.35]) {
              compressed = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', quality));
              if (compressed && compressed.size <= 290_000) break;
            }
            if (compressed && compressed.size <= 290_000) break;
            canvas.width = Math.max(1, Math.round(canvas.width * 0.8));
            canvas.height = Math.max(1, Math.round(canvas.height * 0.8));
            context.drawImage(image, 0, 0, canvas.width, canvas.height);
          }
          if (!compressed || compressed.size > 290_000) throw new Error('Photo encore trop volumineuse. Choisissez une image plus simple.');
          let photo = new Uint8Array(await compressed.arrayBuffer());
          if (gps) {
            const cleanUrl = await new Promise<string>((resolve, reject) => {
              const reader = new FileReader();
              reader.onload = () => resolve(String(reader.result));
              reader.onerror = () => reject(new Error('Lecture impossible.'));
              reader.readAsDataURL(compressed);
            });
            const withGps = piexif.insert(piexif.dump({ '0th': {}, GPS: gps }), cleanUrl);
            const response = await fetch(withGps);
            photo = new Uint8Array(await response.arrayBuffer());
          }
          if (photo.length > 300_000) throw new Error('Photo encore trop volumineuse. Choisissez une image plus simple.');
          const transfer = new DataTransfer();
          transfer.items.add(new File([photo], 'indice.jpg', { type: 'image/jpeg' }));
          input.files = transfer.files;
          if (sourceField) sourceField.value = locationSource ?? '';
          status.textContent = 'Photo prête. Envoi en cours…';
          form.submit();
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Photo invalide.';
        }
      });
    </script>
  </body>
</html>

<style>
  :global(body) { margin: 0; background: #f8f5ef; color: #24231f; font: 1rem/1.55 system-ui, sans-serif; }
  main { max-width: 42rem; margin: auto; padding: 1.5rem 1rem 4rem; }
  .back { color: #62472f; }
  .eyebrow { margin-top: 2.5rem; color: #775536; font-size: .8rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: .25rem 0; font-size: clamp(2rem, 7vw, 3.25rem); line-height: 1.1; }
  .model { margin: .5rem 0; color: #565047; }
  .intro { font-size: 1.1rem; }
  .count { padding: .8rem 1rem; background: #e6eee4; border-radius: .5rem; font-weight: 600; }
  .errors { padding: 1rem; background: #ffe8e3; border-left: .25rem solid #a52718; border-radius: .25rem; }
  .errors ul { margin-bottom: 0; }
  fieldset { margin: 1.25rem 0; padding: 1.25rem; border: 1px solid #d4c8b8; border-radius: .75rem; background: #fff; }
  legend { padding: 0 .25rem; font-weight: 750; font-size: 1.2rem; }
  legend span, label span, small { color: #665f56; font-size: .85rem; font-weight: 400; }
  fieldset p { margin-top: .25rem; color: #565047; }
  label:not(.check, .choice), .choice { display: block; margin: .9rem 0 .3rem; font-weight: 650; }
  input[type='text'], input[type='email'], input[type='file'], select, textarea { box-sizing: border-box; width: 100%; padding: .7rem; border: 1px solid #8e857a; border-radius: .35rem; background: #fff; color: inherit; font: inherit; }
  input:focus-visible, select:focus-visible, textarea:focus-visible, button:focus-visible, a:focus-visible { outline: .2rem solid #a15c27; outline-offset: .15rem; }
  .check { display: flex; gap: .6rem; align-items: flex-start; margin: .8rem 0 1.25rem; }
  .choice { display: flex; gap: .6rem; align-items: center; }
  .check input, .choice input, .models input { margin-top: .3rem; flex: none; accent-color: #704519; }
  .models { padding-left: 1.5rem; }
  .models li { margin: .4rem 0; }
  .models label { cursor: pointer; }
  button { width: 100%; padding: .95rem 1.25rem; border: 0; border-radius: .5rem; background: #603b21; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  button:hover { background: #452912; }
</style>
