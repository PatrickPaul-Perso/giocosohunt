---
import { env } from 'cloudflare:workers';

const { uuid } = Astro.params;
const campaignSlug = 'halloween-2026';

if (!uuid || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(uuid)) {
  return new Response('Figurine introuvable', { status: 404 });
}

Astro.response.headers.set('Cache-Control', 'no-store');

let displayName: string;
let scanCount: number;

try {
  const item = await env.DB.prepare(
    'SELECT i.display_name FROM items i JOIN campaigns c ON c.id = i.campaign_id WHERE i.id = ? AND c.slug = ?',
  ).bind(uuid, campaignSlug).first<{ display_name: string }>();

  if (!item) {
    return new Response('Figurine introuvable', { status: 404 });
  }

  await env.DB.prepare('INSERT INTO scan_events (id, item_id) VALUES (?, ?)')
    .bind(crypto.randomUUID(), uuid)
    .run();

  const summary = await env.DB.prepare('SELECT COUNT(*) AS total FROM scan_events WHERE item_id = ?')
    .bind(uuid)
    .first<{ total: number }>();

  displayName = item.display_name;
  scanCount = summary?.total ?? 0;
} catch (error) {
  console.error('Impossible de simuler le scan', error);
  return new Response('Base D1 indisponible ou non préparée. Appliquez la migration et les données de démonstration.', {
    status: 503,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{displayName} — Giocoso Hunt</title>
  </head>
  <body>
    <main>
      <a href="/halloween-2026">Retour à la campagne</a>
      <h1>{displayName}</h1>
      <p>Scan de démonstration enregistré.</p>
      <p>Nombre de scans enregistrés pour cette figurine : <strong>{scanCount}</strong></p>
      <p>Chaque nouvelle ouverture de cette page ajoute un scan.</p>
    </main>
  </body>
</html>
