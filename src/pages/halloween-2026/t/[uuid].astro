---
import { env } from 'cloudflare:workers';
import { Image } from 'astro:assets';
import chatFantomePhoto from '../../../assets/items/chat_fantome.jpg';
import SiteLayout from '../../../components/SiteLayout.astro';
import ScanLocation from '../../../components/ScanLocation.astro';
import ScanHistory, { type HistoryEntry } from '../../../components/ScanHistory.astro';
import { getScanHistory } from '../../../lib/scan-history';
import { pageLanguage } from '../../../lib/page';
import { getSiteSettings } from '../../../lib/settings';
import { scanCopy, scanError } from '../../../lib/scan-copy';
import {
  emptyFormValues,
  parseScanResponse,
  saveScanResponse,
  type FormValues,
} from '../../../lib/scan-response';

const { uuid } = Astro.params;
const campaignSlug = 'halloween-2026';
const chatFantomeUuid = '00000000-0000-4000-8000-000000000001';
const language = pageLanguage(Astro);
const settings = await getSiteSettings(env.DB);
const t = scanCopy[language];

if (!uuid || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(uuid)) {
  return new Response(t.notFound, { status: 404 });
}
if (Astro.request.method !== 'GET' && Astro.request.method !== 'POST') {
  return new Response(t.method, { status: 405 });
}

Astro.response.headers.set('Cache-Control', 'no-store');

let displayName: string;
let scanCount: number;
let history: HistoryEntry[] = [];
let formValues: FormValues = emptyFormValues();
let errors: string[] = [];

try {
  const item = await env.DB.prepare(`SELECT i.display_name
    FROM items i JOIN campaigns c ON c.id = i.campaign_id
    WHERE i.id = ? AND c.slug = ?`)
    .bind(uuid, campaignSlug)
    .first<{ display_name: string }>();

  if (!item) return new Response(t.notFound, { status: 404 });
  displayName = uuid === chatFantomeUuid && language === 'en' ? 'Ghost cat' : item.display_name;

  if (Astro.request.method === 'GET') {
    const scanEventId = crypto.randomUUID();
    await env.DB.prepare('INSERT INTO scan_events (id, item_id) VALUES (?, ?)')
      .bind(scanEventId, uuid)
      .run();
    formValues = emptyFormValues(scanEventId);
  } else {
    const origin = Astro.request.headers.get('origin');
    if (origin && origin !== new URL(Astro.request.url).origin) {
      return new Response(t.origin, { status: 403 });
    }
    const contentType = Astro.request.headers.get('content-type') ?? '';
    if (!contentType.startsWith('multipart/form-data')) {
      return new Response(t.contentType, { status: 415 });
    }
    if (Number(Astro.request.headers.get('content-length') ?? 0) > 400_000) {
      return new Response(t.tooLarge, { status: 413 });
    }

    const form = await Astro.request.formData();
    const parsed = await parseScanResponse(form);
    formValues = parsed.values;
    errors = parsed.errors;

    if (parsed.submission) {
      const result = await saveScanResponse(env.DB, uuid, parsed.submission, settings.locationFudgeMaxMeters);
      if (result === 'saved') return Astro.redirect('/halloween-2026/merci', 303);
      errors.push(result === 'already_submitted'
        ? 'Cette participation a déjà été enregistrée. Ouvrez de nouveau la fiche pour recommencer.'
        : 'Ce scan est introuvable. Ouvrez de nouveau la fiche pour recommencer.');
    }
    Astro.response.status = 400;
  }

  const summary = await env.DB.prepare('SELECT COUNT(*) AS total FROM scan_events WHERE item_id = ?')
    .bind(uuid)
    .first<{ total: number }>();
  scanCount = summary?.total ?? 0;
  history = await getScanHistory(env.DB, uuid);
} catch {
  console.error('Impossible de traiter la participation à un scan');
  return new Response(t.unavailable, {
    status: 503,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}
---

<SiteLayout language={language} title={displayName} settings={settings}>
  <main>
    <div class="scan-content">
    <a class="back" href="/halloween-2026">← {t.back}</a>
    <p class="eyebrow">Giocoso Hunt · Halloween 2026</p>
    <h1>{displayName}</h1>
    {uuid === chatFantomeUuid && (
      <figure class="item-photo">
        <Image src={chatFantomePhoto} alt={language === 'fr' ? 'Figurine Chat fantôme' : 'Ghost cat figurine'} width={720} />
      </figure>
    )}
    <p class="intro">{t.intro}</p>
    <p class="count">{t.scanSaved} · {scanCount} {language === 'fr' ? `scan${scanCount > 1 ? 's' : ''}` : `scan${scanCount > 1 ? 's' : ''}`} {t.total}</p>

    {errors.length > 0 && (
      <div class="errors" role="alert">
        <strong>{t.verify}</strong>
        <ul>{errors.map((error) => <li>{scanError(error, language)}</li>)}</ul>
      </div>
    )}

    <form method="POST" enctype="multipart/form-data" id="participation-form">
      <input type="hidden" name="scan_event_id" value={formValues.scanEventId} />
      <input type="hidden" name="location_source" value="" />
      <ScanLocation language={language} kind="scan" selected={formValues.approxLocation} />

      <fieldset>
        <legend>{t.identity} <span>{t.optional}</span></legend>
        <p>{t.anonymous}</p>
        <label for="social-platform">{t.network}</label>
        <select id="social-platform" name="social_platform">
          <option value="">{t.chooseNetwork}</option>
          <option value="tiktok" selected={formValues.socialPlatform === 'tiktok'}>TikTok</option>
          <option value="facebook" selected={formValues.socialPlatform === 'facebook'}>Facebook</option>
          <option value="instagram" selected={formValues.socialPlatform === 'instagram'}>Instagram</option>
        </select>
        <label for="social-handle">{t.handle}</label>
        <input id="social-handle" name="social_handle" type="text" autocomplete="off" maxlength="51" placeholder="@your_handle" value={formValues.socialHandle} />
        <label class="check"><input type="checkbox" name="social_consent" checked={formValues.socialConsent} /> {t.socialConsent}</label>
        <label for="email">{t.email} <span>{t.optional}</span></label>
        <input id="email" name="email" type="email" autocomplete="email" maxlength="254" value={formValues.email} />
        <label class="check"><input type="checkbox" name="email_consent" checked={formValues.emailConsent} /> {t.emailConsent}</label>
      </fieldset>

      <fieldset>
        <legend>{t.figurine}</legend>
        <p>{t.later}</p>
        <label class="choice"><input type="radio" name="disposition" value="keep" checked={formValues.disposition === 'keep'} required /> {t.keep}</label>
        <label class="choice"><input type="radio" name="disposition" value="rehide" checked={formValues.disposition === 'rehide'} required /> {t.rehide}</label>
        <ScanLocation language={language} kind="rehide" selected={formValues.rehideLocation} />
        <label for="clue">{t.clue} <span>{t.optional}</span></label>
        <textarea id="clue" name="clue_text" rows="3" maxlength="160" placeholder={t.cluePlaceholder}>{formValues.clueText}</textarea>
        <small>{t.clueHelp}</small>
        <label for="clue-photo">{t.photo} <span>{t.photoOptional}</span></label>
        <input id="clue-photo" name="clue_photo" type="file" accept="image/jpeg" />
        <small>{t.photoHelp}</small>
        <label class="check"><input type="checkbox" name="public_clue_consent" checked={formValues.publicClueConsent} /> {t.publicClueConsent}</label>
        <label class="check"><input type="checkbox" name="gps_consent" checked={formValues.gpsConsent} /> {t.gpsConsent}</label>
        <label class="check"><input type="checkbox" name="device_location_consent" checked={formValues.deviceLocationConsent} /> {t.deviceConsent}</label>
        <p id="photo-status" role="status" aria-live="polite"></p>
      </fieldset>

      <button type="submit">{t.submit}</button>
    </form>
    </div>
    <ScanHistory entries={history} photoBasePath={`/halloween-2026/t/${uuid}/photo`} language={language} />
  </main>
    <script>
      import piexif from 'piexifjs';
      const tr = (fr: string, en: string) => document.documentElement.lang.startsWith('en') ? en : fr;

      const form = document.querySelector<HTMLFormElement>('#participation-form');
      const input = document.querySelector<HTMLInputElement>('#clue-photo');
      const status = document.querySelector<HTMLElement>('#photo-status');
      form?.addEventListener('submit', async (event) => {
        const original = input?.files?.[0];
        if (!original || !input || !status) return;
        event.preventDefault();
        status.textContent = tr('Préparation de la photo…', 'Preparing the photo…');
        try {
          if (original.type !== 'image/jpeg' || original.size > 15_000_000) throw new Error(tr('Choisissez un JPEG de 15 Mo ou moins.', 'Choose a JPEG of 15 MB or less.'));
          const gpsConsent = form.querySelector<HTMLInputElement>('[name="gps_consent"]')?.checked ?? false;
          const deviceLocationConsent = form.querySelector<HTMLInputElement>('[name="device_location_consent"]')?.checked ?? false;
          const sourceField = form.querySelector<HTMLInputElement>('[name="location_source"]');
          if (sourceField) sourceField.value = '';
          const originalUrl = await new Promise<string>((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result));
            reader.onerror = () => reject(new Error(tr('Lecture de la photo impossible.', 'Could not read the photo.')));
            reader.readAsDataURL(original);
          });
          let gps: Record<number, unknown> | null = null;
          let locationSource: 'photo' | 'device' | null = null;
          if (gpsConsent) {
            try {
              const source = piexif.load(originalUrl).GPS;
              const keys = piexif.GPSIFD;
              if (source && source[keys.GPSLatitudeRef] && source[keys.GPSLatitude] && source[keys.GPSLongitudeRef] && source[keys.GPSLongitude]) {
                locationSource = 'photo';
                gps = {
                  [keys.GPSLatitudeRef]: source[keys.GPSLatitudeRef],
                  [keys.GPSLatitude]: source[keys.GPSLatitude],
                  [keys.GPSLongitudeRef]: source[keys.GPSLongitudeRef],
                  [keys.GPSLongitude]: source[keys.GPSLongitude],
                };
              }
            } catch { /* La photo peut ne contenir aucun EXIF. */ }
          }
          if (!gps && deviceLocationConsent) {
            if (!navigator.geolocation) throw new Error(tr('La position du navigateur est indisponible. Décochez les consentements GPS pour continuer sans coordonnées.', 'Browser location is unavailable. Clear the GPS consent boxes to continue without coordinates.'));
            status.textContent = tr('Demande de la position actuelle…', 'Requesting current location…');
            const position = await new Promise<GeolocationPosition>((resolve, reject) => {
              navigator.geolocation.getCurrentPosition(resolve, reject, {
                enableHighAccuracy: true,
                maximumAge: 0,
                timeout: 15_000,
              });
            }).catch(() => { throw new Error(tr('Position refusée ou indisponible. Décochez les consentements GPS pour continuer sans coordonnées.', 'Location denied or unavailable. Clear the GPS consent boxes to continue without coordinates.')); });
            const latitude = position.coords.latitude;
            const longitude = position.coords.longitude;
            if (!Number.isFinite(latitude) || !Number.isFinite(longitude) || Math.abs(latitude) > 90 || Math.abs(longitude) > 180) {
              throw new Error(tr('Position actuelle invalide.', 'Current location is invalid.'));
            }
            const keys = piexif.GPSIFD;
            gps = {
              [keys.GPSLatitudeRef]: latitude < 0 ? 'S' : 'N',
              [keys.GPSLatitude]: piexif.GPSHelper.degToDmsRational(Math.abs(latitude)),
              [keys.GPSLongitudeRef]: longitude < 0 ? 'W' : 'E',
              [keys.GPSLongitude]: piexif.GPSHelper.degToDmsRational(Math.abs(longitude)),
            };
            locationSource = 'device';
          }
          if (!gps && gpsConsent) {
            throw new Error(tr('La photo fournie ne contient pas de GPS. Autorisez la position actuelle, ou décochez le consentement GPS pour continuer sans coordonnées.', 'The photo has no GPS. Allow current location, or clear GPS consent to continue without coordinates.'));
          }
          const image = new Image();
          image.src = originalUrl;
          await image.decode();
          const scale = Math.min(1, 1200 / Math.max(image.naturalWidth, image.naturalHeight));
          const canvas = document.createElement('canvas');
          canvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
          canvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
          const context = canvas.getContext('2d');
          if (!context) throw new Error(tr('Compression indisponible dans ce navigateur.', 'Compression is unavailable in this browser.'));
          context.drawImage(image, 0, 0, canvas.width, canvas.height);
          let compressed: Blob | null = null;
          for (let attempt = 0; attempt < 4; attempt++) {
            for (const quality of [0.8, 0.65, 0.5, 0.35]) {
              compressed = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', quality));
              if (compressed && compressed.size <= 290_000) break;
            }
            if (compressed && compressed.size <= 290_000) break;
            canvas.width = Math.max(1, Math.round(canvas.width * 0.8));
            canvas.height = Math.max(1, Math.round(canvas.height * 0.8));
            context.drawImage(image, 0, 0, canvas.width, canvas.height);
          }
          if (!compressed || compressed.size > 290_000) throw new Error(tr('Photo encore trop volumineuse. Choisissez une image plus simple.', 'The photo is still too large. Choose a simpler image.'));
          let photo = new Uint8Array(await compressed.arrayBuffer());
          if (gps) {
            const cleanUrl = await new Promise<string>((resolve, reject) => {
              const reader = new FileReader();
              reader.onload = () => resolve(String(reader.result));
              reader.onerror = () => reject(new Error(tr('Lecture impossible.', 'Could not read the image.')));
              reader.readAsDataURL(compressed);
            });
            const withGps = piexif.insert(piexif.dump({ '0th': {}, GPS: gps }), cleanUrl);
            const response = await fetch(withGps);
            photo = new Uint8Array(await response.arrayBuffer());
          }
          if (photo.length > 300_000) throw new Error(tr('Photo encore trop volumineuse. Choisissez une image plus simple.', 'The photo is still too large. Choose a simpler image.'));
          const transfer = new DataTransfer();
          transfer.items.add(new File([photo], 'indice.jpg', { type: 'image/jpeg' }));
          input.files = transfer.files;
          if (sourceField) sourceField.value = locationSource ?? '';
          status.textContent = tr('Photo prête. Envoi en cours…', 'Photo ready. Sending…');
          form.submit();
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : tr('Photo invalide.', 'Invalid photo.');
        }
      });
    </script>
</SiteLayout>

<style>
  main { max-width: 72rem; margin: auto; padding: 1.5rem 1rem 4rem; }
  .scan-content { max-width: 42rem; margin: auto; }
  .back { color: var(--accent); }
  .eyebrow { margin-top: 2.5rem; color: #775536; font-size: .8rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: .25rem 0; font-size: clamp(2rem, 7vw, 3.25rem); line-height: 1.1; }
  .intro { font-size: 1.1rem; }
  .item-photo { margin: 1.5rem 0; overflow: hidden; border-radius: .75rem; background: #eee8df; text-align: center; }
  .item-photo :global(img) { display: block; max-width: 100%; width: auto; max-height: 38rem; height: auto; margin: auto; }
  .count { padding: .8rem 1rem; background: #e6eee4; border-radius: .5rem; font-weight: 600; }
  .errors { padding: 1rem; background: #ffe8e3; border-left: .25rem solid #a52718; border-radius: .25rem; }
  .errors ul { margin-bottom: 0; }
  fieldset { margin: 1.25rem 0; padding: 1.25rem; border: 1px solid #d4c8b8; border-radius: .75rem; background: #fff; }
  legend { padding: 0 .25rem; font-weight: 750; font-size: 1.2rem; }
  legend span, label span, small { color: #665f56; font-size: .85rem; font-weight: 400; }
  fieldset p { margin-top: .25rem; color: #565047; }
  label:not(.check, .choice), .choice { display: block; margin: .9rem 0 .3rem; font-weight: 650; }
  input[type='text'], input[type='email'], input[type='file'], select, textarea { box-sizing: border-box; width: 100%; padding: .7rem; border: 1px solid #8e857a; border-radius: .35rem; background: #fff; color: inherit; font: inherit; }
  input:focus-visible, select:focus-visible, textarea:focus-visible, button:focus-visible, a:focus-visible { outline: .2rem solid var(--accent); outline-offset: .15rem; }
  .check { display: flex; gap: .6rem; align-items: flex-start; margin: .8rem 0 1.25rem; }
  .choice { display: flex; gap: .6rem; align-items: center; }
  .check input, .choice input { margin-top: .3rem; flex: none; accent-color: var(--accent); }
  button { width: 100%; padding: .95rem 1.25rem; border: 0; border-radius: .5rem; background: var(--accent); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  button:hover { filter: brightness(.85); }
</style>
