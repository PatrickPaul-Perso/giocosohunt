---
import { env } from 'cloudflare:workers';
import SiteLayout from '../components/SiteLayout.astro';
import { pageLanguage } from '../lib/page';
import { getActiveCampaign, getSiteSettings } from '../lib/settings';
import { parseVote, saveVote, type VoteCandidate, type VoteValues } from '../lib/vote';

Astro.response.headers.set('Cache-Control', 'no-store');
const language = pageLanguage(Astro);
const settings = await getSiteSettings(env.DB);
let campaign: Awaited<ReturnType<typeof getActiveCampaign>> = null;
let candidates: VoteCandidate[] = [];
let error: 'database' | 'campaign' | 'validation' | 'closed' | null = null;
let errors: string[] = [];
let values: VoteValues = { email: '', contactConsent: false, choice: '', proposedName: '' };

try {
  campaign = await getActiveCampaign(env.DB, settings);
  if (!campaign) error = 'campaign';
  const result = await env.DB.prepare('SELECT id, name, description FROM model_candidates ORDER BY name, id').all<VoteCandidate>();
  candidates = result.results;
} catch {
  error = 'database';
}

if (Astro.request.method === 'POST') {
  const origin = Astro.request.headers.get('origin');
  if (origin && origin !== Astro.url.origin) return new Response('Forbidden', { status: 403 });
  if (!Astro.request.headers.get('content-type')?.startsWith('application/x-www-form-urlencoded')) return new Response('Unsupported Media Type', { status: 415 });
  if (Number(Astro.request.headers.get('content-length') ?? 0) > 5_000) return new Response('Payload Too Large', { status: 413 });
  const form = await Astro.request.formData();
  const parsed = parseVote(form, candidates);
  values = parsed.values;
  errors = parsed.errors;
  if (!settings.contestOpen) error = 'closed';
  else if (!campaign || error) error ??= 'campaign';
  else if (!parsed.submission) error = 'validation';
  else {
    try {
      await saveVote(env.DB, campaign.id, parsed.submission);
      return Astro.redirect('/vote?success=1', 303);
    } catch {
      error = 'database';
    }
  }
  Astro.response.status = error === 'validation' ? 400 : 503;
}

const t = language === 'fr' ? {
  title: 'Vote et propositions', intro: 'Choisissez un modèle Giocoso Création ou proposez une nouvelle idée.',
  discount: 'En votant pour un modèle en vente, vous pourriez courir la chance de recevoir un rabais pour un achat dans la boutique Etsy Giocoso Création.',
  free: 'En proposant un nouveau modèle, vous pourriez courir la chance d’en recevoir une copie gratuitement.',
  rules: 'Le tirage ouvrira après publication et validation de ses modalités.', terms: 'Modalités du tirage',
  closed: 'Le tirage n’est pas encore ouvert. Vous pouvez découvrir les modèles, mais aucun vote n’est accepté pour le moment.',
  campaign: 'Campagne', email: 'Votre courriel', consent: 'J’autorise Giocoso Hunt à conserver mon courriel pour me contacter au sujet du tirage de cette campagne.',
  propose: 'Proposer un nouveau modèle', proposalName: 'Nom proposé', submit: 'Enregistrer ma participation',
  success: 'Votre participation a été enregistrée. Un nouveau choix avec le même courriel remplacera celui-ci pour cette campagne.',
  invalid: 'Vérifiez le courriel, le consentement et le choix de modèle ou le nom proposé.', unavailable: 'Le vote est temporairement indisponible.',
} : {
  title: 'Vote and proposals', intro: 'Choose a Giocoso Creation model or suggest a new one.',
  discount: 'By voting for a model for sale, you may have a chance to receive a discount for a purchase from the Giocoso Creation Etsy shop.',
  free: 'By suggesting a new model, you may have a chance to receive a free copy.',
  rules: 'The draw will open after its terms are published and approved.', terms: 'Draw terms',
  closed: 'The draw is not open yet. You can browse the models, but votes are not being accepted.',
  campaign: 'Campaign', email: 'Your email', consent: 'I authorize Giocoso Hunt to keep my email to contact me about this campaign’s draw.',
  propose: 'Suggest a new model', proposalName: 'Suggested name', submit: 'Save my entry',
  success: 'Your entry was saved. A new choice using the same email will replace it for this campaign.',
  invalid: 'Check the email, consent, and model choice or proposed name.', unavailable: 'Voting is temporarily unavailable.',
};
---
<SiteLayout language={language} title={t.title} settings={settings}>
  <main>
    <h1>{t.title}</h1>
    <p>{t.intro}</p>
    {campaign && <p class="campaign">{t.campaign}: {campaign.title}</p>}
    <p>{t.discount}</p>
    <p>{t.free}</p>
    {settings.contestOpen && settings.contestTermsUrl ? <p class="rules"><a href={settings.contestTermsUrl}>{t.terms}</a></p> : <p class="rules">{t.rules}</p>}
    {Astro.url.searchParams.get('success') === '1' && <p role="status" class="notice">{t.success}</p>}
    {!settings.contestOpen && <p role="status" class="notice">{t.closed}</p>}
    {!settings.contestOpen && candidates.length > 0 && <ul>{candidates.map((candidate) => <li>{candidate.name}{candidate.description && <p>{candidate.description}</p>}</li>)}</ul>}
    {(error === 'database' || error === 'campaign') && <p role="alert">{t.unavailable}</p>}
    {error === 'validation' && <p role="alert">{t.invalid}</p>}
    {error === 'closed' && <p role="alert">{t.closed}</p>}
    {settings.contestOpen && campaign && error !== 'database' && (
      <form method="POST">
        <fieldset>
          <legend>{t.title}</legend>
          <ul>
            {candidates.map((candidate) => <li><label><input type="radio" name="choice" value={candidate.id} checked={values.choice === candidate.id} required /> {candidate.name}</label>{candidate.description && <p>{candidate.description}</p>}</li>)}
            <li><label><input type="radio" name="choice" value="proposal" checked={values.choice === 'proposal'} required /> {t.propose}</label></li>
          </ul>
          <label for="proposed-name">{t.proposalName}</label>
          <input id="proposed-name" name="proposed_name" maxlength="60" value={values.proposedName} aria-invalid={errors.includes('proposed_name') ? 'true' : undefined} />
        </fieldset>
        <label for="email">{t.email}</label>
        <input id="email" type="email" name="email" autocomplete="email" maxlength="254" value={values.email} required aria-invalid={errors.includes('email') ? 'true' : undefined} />
        <label class="consent"><input type="checkbox" name="contact_consent" checked={values.contactConsent} required /> {t.consent}</label>
        <button type="submit">{t.submit}</button>
      </form>
    )}
  </main>
</SiteLayout>
<style>
  main { max-width: 42rem; margin: 3rem auto; padding: 0 1rem; }
  h1 { font-size: clamp(2rem, 6vw, 3rem); }
  .campaign, .rules { font-weight: 600; }
  .notice { padding: 1rem; background: #e6eee4; border-radius: .5rem; }
  fieldset { margin: 1.5rem 0; padding: 1rem; border: 1px solid #d4c8b8; border-radius: .5rem; }
  li { margin: .7rem 0; }
  li p { margin: .1rem 0 .5rem 1.5rem; }
  label { display: block; margin: .7rem 0 .3rem; }
  input:not([type='radio'], [type='checkbox']) { box-sizing: border-box; width: 100%; padding: .7rem; font: inherit; }
  .consent { display: flex; gap: .5rem; align-items: flex-start; margin: 1rem 0; }
  button { padding: .8rem 1.2rem; border: 0; border-radius: .4rem; font: inherit; font-weight: 700; cursor: pointer; }
</style>
