---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Language } from '../lib/locale';
import type { VoteCandidate } from '../lib/vote';
import { etsyListingUrl } from '../lib/model-media';

const { candidate, image, language, selectable = false, checked = false } = Astro.props as {
  candidate: VoteCandidate;
  image?: ImageMetadata;
  language: Language;
  selectable?: boolean;
  checked?: boolean;
};
const fr = language === 'fr';
const productUrl = etsyListingUrl(candidate.etsy_url);
---
<article class="model-card">
  <div class="photo">
    {image ? <Image src={image} alt={fr ? `Modèle ${candidate.name}` : `${candidate.name} model`} width={640} /> : <div class="placeholder" aria-hidden="true">?</div>}
  </div>
  <div class="content">
    {selectable ? (
      <label class="choice"><input type="radio" name="choice" value={candidate.id} checked={checked} required /> <span>{candidate.name}</span></label>
    ) : <h2>{candidate.name}</h2>}
    {candidate.description && <p>{candidate.description}</p>}
    {productUrl && <a href={productUrl} target="_blank" rel="noopener noreferrer">{fr ? 'Voir la fiche sur Etsy ↗' : 'View on Etsy ↗'}</a>}
  </div>
</article>
<style>
  .model-card { height: 100%; overflow: hidden; border: 1px solid #d4c8b8; border-radius: .75rem; background: white; }
  .photo { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: #eee8df; }
  .photo :global(img) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; }
  .placeholder { display: grid; place-items: center; height: 100%; color: #887563; font-size: 4rem; }
  .content { padding: 1rem; }
  h2 { margin: 0; font-size: 1.2rem; }
  .choice { display: flex; gap: .6rem; align-items: flex-start; margin: 0; font-weight: 700; font-size: 1.2rem; }
  .choice input { margin-top: .3rem; accent-color: var(--accent); }
  p { margin: .6rem 0; }
  a { display: inline-block; margin-top: .4rem; color: var(--accent); }
</style>
