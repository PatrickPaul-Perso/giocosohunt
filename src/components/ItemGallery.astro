---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Language } from '../lib/locale';

type GalleryItem = { name: string; image?: ImageMetadata };
const { items, language } = Astro.props as { items: GalleryItem[]; language: Language };
const fr = language === 'fr';
---
<section class="gallery" aria-labelledby="gallery-title">
  <div class="gallery-heading">
    <p class="eyebrow">Giocoso Hunt · Halloween 2026</p>
    <h2 id="gallery-title">{fr ? 'Les figurines à trouver' : 'Figurines to find'}</h2>
    <p>{fr
      ? 'Découvrez les figurines cachées dans la région d’Ottawa–Gatineau. Leur emplacement reste secret jusqu’à ce que vous les trouviez.'
      : 'Discover the figurines hidden in the Ottawa–Gatineau region. Their locations remain secret until you find them.'}</p>
  </div>
  {items.length ? (
    <ul class="cards">
      {items.map((item) => (
        <li>
          <article class="card">
            <div class="photo">
              {item.image ? (
                <Image src={item.image} alt={fr ? `Photo de la figurine ${item.name}` : `Photo of the ${item.name} figurine`} width={720} format="webp" />
              ) : (
                <div class="placeholder" aria-hidden="true"><span>?</span></div>
              )}
            </div>
            <div class="card-content">
              <span class="status">{fr ? 'À découvrir' : 'To discover'}</span>
              <h3>{item.name}</h3>
              {!item.image && <p>{fr ? 'Photo à venir' : 'Photo coming soon'}</p>}
            </div>
          </article>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">{fr ? 'Les figurines seront présentées ici bientôt.' : 'The figurines will appear here soon.'}</p>
  )}
</section>
<style>
  .gallery { margin-top: 4rem; }
  .gallery-heading { max-width: 42rem; }
  .eyebrow { color: var(--accent); font-size: .8rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  h2 { margin: .2rem 0 1rem; font-size: clamp(1.7rem, 5vw, 2.5rem); line-height: 1.15; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 1.25rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .card { overflow: hidden; height: 100%; border: 1px solid #d4c8b8; border-radius: .75rem; background: #fff; box-shadow: 0 .5rem 1.5rem #24231f0b; }
  .photo { display: grid; place-items: center; aspect-ratio: 4 / 3; overflow: hidden; background: #eee8df; }
  .photo :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .placeholder { display: grid; place-items: center; width: 100%; height: 100%; color: var(--accent); background: radial-gradient(circle at center, #fff 0, #eee8df 75%); }
  .placeholder span { font-size: 5rem; font-weight: 800; opacity: .45; }
  .card-content { padding: 1rem 1.2rem 1.3rem; }
  .status { color: var(--accent); font-size: .75rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  h3 { margin: .35rem 0; font-size: 1.3rem; }
  .card-content p { margin: .25rem 0 0; color: #665f56; }
  .empty { padding: 1.5rem; border: 1px dashed #b5a99a; border-radius: .75rem; }
</style>
