---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Language } from '../lib/locale';
import type { FigurineClass } from '../lib/figurine-classes';
const { classes, campaignSlug, language } = Astro.props as { classes: FigurineClass[]; campaignSlug: string; language: Language };
const fr = language === 'fr';
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/items/*.{jpg,jpeg,png,webp}', { eager: true });
const photoFor = (key: string | null) => key ? photos[`../assets/items/${key}`]?.default : undefined;
---
<section aria-labelledby="classes-title">
  <h2 id="classes-title">{fr ? 'Les groupes de figurines' : 'Figurine groups'}</h2>
  <p>{fr ? 'Choisissez un groupe pour découvrir ses figurines et leur parcours.' : 'Choose a group to discover its figurines and their journeys.'}</p>
  <ul>
    {classes.map((figurineClass) => {
      const name = fr ? figurineClass.name_fr : figurineClass.name_en;
      const image = photoFor(figurineClass.image_key);
      return <li><a class="card" href={`/${campaignSlug}/classes/${figurineClass.slug}?lang=${language}`}>
        <div class="photo">{image ? <Image src={image} alt={name} width={720} /> : <span>{fr ? 'Photo à venir' : 'Photo coming soon'}</span>}</div>
        <div class="content"><h3>{name}</h3><p>{figurineClass.instance_count} figurines</p><span>{fr ? 'Découvrir les figurines' : 'Discover the figurines'} →</span></div>
      </a></li>;
    })}
  </ul>
  {!classes.length && <p>{fr ? 'Les groupes de figurines seront présentés ici bientôt.' : 'Figurine groups will appear here soon.'}</p>}
</section>
<style>
  section { margin-top: 3rem; }
  h2 { font-size: clamp(1.7rem, 5vw, 2.5rem); }
  ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 1.5rem; padding: 0; list-style: none; }
  .card { display: block; overflow: hidden; border: 1px solid #d4c8b8; border-radius: .75rem; background: white; text-decoration: none; }
  .photo { display: grid; place-items: center; aspect-ratio: 4 / 3; background: #eee8df; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .content { padding: 1.25rem; }
  h3 { margin: 0; font-size: 1.4rem; }
  .content span { font-weight: 700; }
</style>
